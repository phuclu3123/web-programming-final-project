# File này chỉ là mẫu; PHP đang đọc getenv(), chưa tự nạp file .env.
# Đặt biến môi trường cho PHP/XAMPP theo database/README.md.
# Nếu dùng Apache trong thư mục con, thêm đúng /CouponHub_UI vào base URL.
COUPONHUB_APP_URL=http://localhost:8000
COUPONHUB_HOST=127.0.0.1
COUPONHUB_PORT=3306
COUPONHUB_DB=dbcouponshubweb_v2
COUPONHUB_USER=root
COUPONHUB_PASSWORD=
COUPONHUB_GITHUB_CLIENT_ID=
COUPONHUB_GITHUB_CLIENT_SECRET=
# Google Cloud Console: OAuth client loại Web application.
COUPONHUB_GOOGLE_CLIENT_ID=
COUPONHUB_GOOGLE_CLIENT_SECRET=
# SMTP nội bộ để tự thử. Chưa tự gửi email khi chỉ mở form.
COUPONHUB_SMTP_HOST=127.0.0.1
COUPONHUB_SMTP_PORT=1025
COUPONHUB_SMTP_ENCRYPTION=none
COUPONHUB_SMTP_USER=
COUPONHUB_SMTP_PASSWORD=
COUPONHUB_MAIL_FROM=no-reply@couponhub.test
