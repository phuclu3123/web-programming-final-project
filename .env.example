# Copy to .env once; keep real credentials outside Git.
# PHP loads .env automatically. Process environment takes priority, even if empty.
COUPONHUB_APP_URL=http://localhost:8000
COUPONHUB_DEBUG=0

# Local database example. Hosting supplies its own database name and credentials.
COUPONHUB_HOST=127.0.0.1
COUPONHUB_PORT=3306
COUPONHUB_DB=dbcouponshubweb_v3
COUPONHUB_USER=root
COUPONHUB_PASSWORD=

# Google Web OAuth client; register origins and callbacks for each environment.
COUPONHUB_GOOGLE_CLIENT_ID=
COUPONHUB_GOOGLE_CLIENT_SECRET=
COUPONHUB_GOOGLE_ONE_TAP=1

# Register exact callback URLs in the provider dashboards.
COUPONHUB_GITHUB_CLIENT_ID=
COUPONHUB_GITHUB_CLIENT_SECRET=
COUPONHUB_FACEBOOK_CLIENT_ID=
COUPONHUB_FACEBOOK_CLIENT_SECRET=
COUPONHUB_FACEBOOK_GRAPH_VERSION=
COUPONHUB_FACEBOOK_REQUEST_EMAIL=0

# Resend is used for password recovery; sender must use a verified sending domain.
COUPONHUB_MAIL_DRIVER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Generate a random secret of at least 32 characters and keep it stable.
COUPONHUB_OTP_SECRET=

# auto allows unconfigured local forms; set required with real keys on production.
COUPONHUB_TURNSTILE_MODE=auto
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost

# Publisher access key stays on the server; source sync writes the review queue.
ACCESSTRADE_ACCESS_KEY=

# Keep local and production session/rate-limit storage separate and writable.
# On hosting use absolute private paths outside public_html when available.
COUPONHUB_SESSION_PATH=
COUPONHUB_RATE_LIMIT_DIR=
COUPONHUB_SESSION_LIFETIME=28800
COUPONHUB_SESSION_IDLE=1800
