# Copy to .env in the project root. PHP loads it automatically.
# Existing process environment wins. Never commit .env.
# Use one hostname: localhost and 127.0.0.1 have different cookies.
# Protected local: scripts/serve-local.ps1 -Port 8080 (stop any unprotected preview before entering secrets).
# Apache subfolder example: http://localhost/CouponHub_UI
COUPONHUB_APP_URL=http://localhost:8080/CouponHub_UI
COUPONHUB_HOST=127.0.0.1
COUPONHUB_PORT=3306
COUPONHUB_DB=dbcouponshubweb_v2
COUPONHUB_USER=root
COUPONHUB_PASSWORD=
COUPONHUB_DEBUG=0
# Persistent session: 30 days like WEB_TCC. Seconds, max 2592000.
# Admin/Merchant additionally capped at 8h absolute and 30min idle.
COUPONHUB_SESSION_LIFETIME=2592000
COUPONHUB_SESSION_IDLE=2592000
COUPONHUB_SESSION_PATH=storage/sessions
# Single-server, shared across browser sessions; keep writable and outside public assets.
COUPONHUB_RATE_LIMIT_DIR=storage/cache
# Callback: APP_URL + /api/oauth/github-callback.php
COUPONHUB_GITHUB_CLIENT_ID=
COUPONHUB_GITHUB_CLIENT_SECRET=
# Google Cloud Web OAuth client (not a Firebase service-account key).
# Callback: APP_URL + /api/oauth/google-callback.php
COUPONHUB_GOOGLE_CLIENT_ID=
COUPONHUB_GOOGLE_CLIENT_SECRET=
# Facebook Login: link once from Account; no unverified-email signup/auto-merge.
# Callback: APP_URL + /api/oauth/facebook-callback.php
COUPONHUB_FACEBOOK_CLIENT_ID=
COUPONHUB_FACEBOOK_CLIENT_SECRET=
# Required: exact supported version in your Meta app dashboard, e.g. v24.0.
COUPONHUB_FACEBOOK_GRAPH_VERSION=
# Use a sender/domain verified in YOUR Resend project.
COUPONHUB_MAIL_DRIVER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="CouponHub <no-reply@your-verified-domain.com>"
# Generate once: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# At least 32 random characters; keep stable between restarts.
COUPONHUB_OTP_SECRET=
# Optional SMTP alternative: set COUPONHUB_MAIL_DRIVER=smtp explicitly.
COUPONHUB_SMTP_HOST=127.0.0.1
COUPONHUB_SMTP_PORT=1025
COUPONHUB_SMTP_ENCRYPTION=none
COUPONHUB_SMTP_USER=
COUPONHUB_SMTP_PASSWORD=
COUPONHUB_MAIL_FROM=no-reply@couponhub.test

# Vietnam Publisher API. Server-only; use the access key from your Publisher account.
ACCESSTRADE_ACCESS_KEY=
# auto: protects forms once either key is present; incomplete config fails closed.
# required: refuse protected writes unless configured. off: explicit local development only.
COUPONHUB_TURNSTILE_MODE=auto
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact frontend hostnames, comma-separated, without scheme/port/path.
# Empty: use the hostname from COUPONHUB_APP_URL. Production: never include localhost.
TURNSTILE_HOSTNAMES=
