# CouponHub: conservative editor rules matching the current codebase.
# Line endings are intentionally not forced: Git handles LF/CRLF on each OS.
root = true

[*]
charset = utf-8
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.php]
indent_size = 4

[*.{js,cjs}]
indent_size = 2

# Existing authentication and app-specific modules use four spaces.
[assets/js/auth/*.js]
indent_size = 4

[app/assets/js/*.js]
indent_size = 4

[*.css]
indent_size = 2

[assets/css/auth/*.css]
indent_size = 4

[app/assets/css/*.css]
indent_size = 4

[*.{json,sql,sh}]
indent_size = 2

[*.py]
indent_size = 4

# Markdown can use trailing spaces for an intentional line break.
[*.md]
trim_trailing_whitespace = false
